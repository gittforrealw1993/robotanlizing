[Unit]
Description=Crypto Analyzer Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/crypto-analyzer
ExecStart=/usr/bin/python3 /root/crypto-analyzer/main.py --mode monitor
Restart=always
RestartSec=30
EnvironmentFile=/root/crypto-analyzer/.env

[Install]
WantedBy=multi-user.target
